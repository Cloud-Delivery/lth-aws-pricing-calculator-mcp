        <mxCell id="arch-step-1" value="1" style="rounded=1;html=1;fillColor=#007CBD;strokeColor=default;strokeWidth=2;shadow=1;glass=0;fontColor=#FFFFFF;fontSize=16;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="290" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="arch-step-2" value="2" style="rounded=1;html=1;fillColor=#007CBD;strokeColor=default;strokeWidth=2;shadow=1;glass=0;fontColor=#FFFFFF;fontSize=16;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="560" y="290" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="arch-step-3" value="3" style="rounded=1;html=1;fillColor=#007CBD;strokeColor=default;strokeWidth=2;shadow=1;glass=0;fontColor=#FFFFFF;fontSize=16;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="820" y="290" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="arch-step-4" value="4" style="rounded=1;html=1;fillColor=#007CBD;strokeColor=default;strokeWidth=2;shadow=1;glass=0;fontColor=#FFFFFF;fontSize=16;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="850" y="385" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="arch-legend" value="" style="rounded=0;container=1;pointerEvents=0;collapsible=0;html=1;fontFamily=Helvetica;fillColor=light-dark(#EDF3FF,#305363);fillStyle=auto;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="1300" y="30" width="440" height="790" as="geometry"/>
        </mxCell>
        <mxCell id="arch-legend-title" value="Flusso e decisioni" style="text;html=1;align=left;fontSize=20;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="arch-legend"><mxGeometry x="20" y="20" width="400" height="40" as="geometry"/></mxCell>
        <mxCell id="arch-legend-steps" value="&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;1. Connessione Copilot Studio&lt;/b&gt;&lt;br&gt;Streamable HTTP con key grezza in x-api-key. Wizard e prova reale dopo deploy (T31).&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Esecuzione MCP&lt;/b&gt;&lt;br&gt;REST API verifica la key; Lambda inoltra al listener Express mediante adapter da validare (T05/T06).&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Stato persistente&lt;/b&gt;&lt;br&gt;DynamoDB conserva stime tra invocazioni. Gli aggiornamenti concorrenti richiedono analisi T08.&lt;br&gt;&lt;br&gt;&lt;b&gt;4. API del Calculator&lt;/b&gt;&lt;br&gt;Dipendenze esterne gia presenti nel codice. Operazioni di salvataggio esterno solo su approvazione.&lt;br&gt;&lt;br&gt;&lt;i&gt;Frecce bidirezionali: richiesta e risposta. CloudWatch: supporto operativo, non passo applicativo.&lt;/i&gt;&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="arch-legend"><mxGeometry x="20" y="75" width="400" height="400" as="geometry"/></mxCell>
        <mxCell id="arch-legend-risk" value="&lt;b&gt;ECCEZIONE SOLO SANDBOX&lt;/b&gt;&lt;br&gt;AWS sconsiglia API key come autenticazione/autorizzazione. Accettata dall'utente come controllo di usage plan, non identita.&lt;br&gt;&lt;br&gt;Key condivisa, nessun isolamento per utente. Quota/throttling best-effort.&lt;br&gt;&lt;br&gt;Nessuna Lambda authorizer o Secrets Manager. Chromium e get_estimate_cost esclusi (implementazione da verificare).&lt;br&gt;&lt;br&gt;Costi, adapter, timeout e design definitivo ancora da approvare in T10." style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fontFamily=Helvetica;fillColor=light-dark(#FFF2E8,#39291F);fillStyle=auto;strokeColor=#ED7100;" vertex="1" parent="arch-legend"><mxGeometry x="20" y="490" width="400" height="280" as="geometry"/></mxCell>
        <mxCell id="arch-footer" value="Stato: risorse AWS pianificate, nessun deploy attestato. IaC CDK prevista in deploy/; upstream read-only. Volumi: &lt; 1000 richieste/giorno.&lt;br&gt;Non abilitato: tool Chromium. API key sandbox approvata; implementazione, costi e collaudo restano aperti." style="text;html=1;whiteSpace=wrap;align=left;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="50" y="850" width="1200" height="65" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
